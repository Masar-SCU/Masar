{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "MasarDb": ""
  },
  "Jwt": {
    "Issuer": "masar-api",
    "Audience": "masar-client",
    "AccessTokenTtlSeconds": 900,
    "RefreshTokenTtlDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://masar.app",
      "https://staging.masar.app"
    ]
  },
  "AllowedHosts": "*"
}
