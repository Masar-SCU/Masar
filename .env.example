# =============================================================================
# Masar Local Environment Configuration
# Copy this file to .env before running: docker compose up -d
# =============================================================================

# Database Credentials (PostgreSQL 16 + pgvector)
# Defaults match appsettings.Development.json for local/container parity
POSTGRES_DB=masar
POSTGRES_USER=masar_dev
POSTGRES_PASSWORD=masar_dev_password
POSTGRES_PORT=5433

# JWT Secret for Masar.Api (Must be at least 32 characters / 256 bits)
JWT_SECRET=masar_dev_jwt_secret_key_minimum_32_characters_for_local_dev!

# Internal AI Service Secret Key (service-to-service auth)
AI_SERVICE_KEY=masar_local_secret_key_123

# Backend & Frontend Ports
BACKEND_PORT=5080
FRONTEND_PORT=5173
